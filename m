@@ -235,7 +235,7 @@ static void test_aead(char *algo, int en
 	struct scatterlist asg[8];
 	const char *e;
 	struct tcrypt_result result;
-	unsigned int authsize;
+	unsigned int authsize = 0;
 
 	if (enc == ENCRYPT)
 		e = "encryption";
@@ -266,8 +266,6 @@ static void test_aead(char *algo, int en
 		return;
 	}
 
-	authsize = crypto_aead_authsize(tfm);
-
 	req = aead_request_alloc(tfm, GFP_KERNEL);
 	if (!req) {
 		printk(KERN_INFO "failed to allocate request for %s\n", algo);
@@ -298,6 +296,19 @@ static void test_aead(char *algo, int en
 					goto out;
 			}
 
+			if (aead_tv[i].tlen) {
+				ret = crypto_aead_setauthsize(tfm,
+							      aead_tv[i].tlen);
+				if (ret) {
+					printk(KERN_INFO
+					       "failed to set authsize = %u\n",
+						aead_tv[i].tlen);
+					goto out;
+				}
+			}
