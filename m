>         bind(fd, (struct sockaddr*)&sa, sizeof(sa));
>         return 0;
> }
> 
> void *thr1(void *arg)
> {
>         accept4(fd, 0, 0, 0x800ul);
>         return 0;
> }
> 
> int main()
> {
>         fd = socket(PF_ALG, SOCK_SEQPACKET, 0);
>         pthread_t th[4];
