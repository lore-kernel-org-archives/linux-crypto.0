---
 drivers/crypto/amlogic/amlogic-gxl-cipher.c |  98 +++++++++++++++--
 drivers/crypto/amlogic/amlogic-gxl-core.c   | 111 ++++----------------
 drivers/crypto/amlogic/amlogic-gxl.h        |  14 +--
