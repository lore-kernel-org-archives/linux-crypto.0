 		dma_sync_single_for_device(dev, edesc->dma_link_tbl,
@@ -1977,7 +1967,7 @@ ahash_process_req_prepare(struct ahash_request *areq, unsigned int nbytes,
 	size_t offset = 0;
 
 	do {
-		src = scatterwalk_ffwd(tmp, req_ctx->psrc, offset);
+		src = scatterwalk_ffwd(tmp, areq->src, offset);
 
 		to_hash_this_desc =
 			min(nbytes, ALIGN_DOWN(desc_max, blocksize));
@@ -1990,8 +1980,7 @@ ahash_process_req_prepare(struct ahash_request *areq, unsigned int nbytes,
